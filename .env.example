# Copy this file to ".env" and fill in your values. Never share or upload .env.
PORT=3000
SECRET_KEY=put-a-long-random-text-here

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dairy_db

DAIRY_NAME=Smart Dairy
DEFAULT_COUNTRY_CODE=+91

# ---- Real SMS / WhatsApp: choose ONE provider ----
SMS_PROVIDER=none          # none | fast2sms | twilio

# Option A: Fast2SMS (India, SMS)
FAST2SMS_KEY=
FAST2SMS_ROUTE=q

# Option B: Twilio (SMS, or WhatsApp if TWILIO_WHATSAPP=1)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP=0
